# Production configuration (non-secret). Secrets come from Jenkins credentials.
NODE_ENV=production
APP_ENV=production
PORT=3000
LOG_LEVEL=info
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20
# Enabled ONLY so the pipeline can run a controlled incident simulation; the endpoints
# require the secret CHAOS_TOKEN. Set to false for a real-world production system.
CHAOS_ENABLED=true
