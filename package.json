{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow - task management REST API (JWT auth, CRUD, Prometheus metrics) delivered through a 7-stage Jenkins DevOps pipeline",
  "main": "src/server.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:report": "node -e \"require('fs').mkdirSync('reports/eslint',{recursive:true})\" && eslint . -f json -o reports/eslint/eslint-report.json",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:e2e": "jest --ci --config jest.e2e.config.js",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  }
}
